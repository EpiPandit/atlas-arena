# Every variable is optional. The defaults (src/config/constants/general.js)
# point at the dev backend and the shared data bucket. Copy to .env.local to
# override. All three values are CloudFormation outputs of the
# atlasarena-model-infra stack (AtlasArenaDevStack or AtlasArenaProdStack) and
# must end in '/'.

# The API ("ApiUrl" output): sign-in and custom model runs.
# NEXT_PUBLIC_ATLASARENA_API_URL=https://REPLACE_ME.execute-api.us-west-2.amazonaws.com/

# Public job outputs ("JobsPublicUrl" output). Must be the same stack as the API.
# NEXT_PUBLIC_ATLASARENA_JOBS_URL=https://REPLACE_ME.s3.us-west-2.amazonaws.com/

# Shared static data ("DataPublicUrl" output), the same for every environment:
# the FOI params CSV (data/FOI/) and the explore page's COGs (cogs/). Must
# allow CORS GET, with Range requests, from the app's origin.
# NEXT_PUBLIC_ATLASARENA_DATA_URL=https://REPLACE_ME.s3.us-west-2.amazonaws.com/
